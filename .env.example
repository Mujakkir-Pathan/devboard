# DevBoard local settings — copy to `.env` (or run `make setup`).
# Every value below is a working default; change only what you need.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard
POSTGRES_HOST_PORT=5432

# --- Backend (Go API) -------------------------------------------------
# Container listens on BACKEND_PORT; mapped to BACKEND_HOST_PORT on your machine.
BACKEND_PORT=8080
BACKEND_HOST_PORT=8081

# --- Frontend (Vite preview in the container) -------------------------
FRONTEND_HOST_PORT=8080

# --- ai-service (Python/Flask) ----------------------------------------
# Published on the host so you can curl it directly.
AI_HOST_PORT=3005
# Model server: any OpenAI-compatible /v1 endpoint.
#   default = Ollama on your machine (`ollama serve`), reached via the
#   host-gateway alias; in-cluster this is set to the shared Ollama service.
MODEL_API_BASE=http://host.docker.internal:11434/v1
MODEL_NAME=llama3.2:1b
# Optional: API key for a hosted provider (Groq, OpenAI, ...). Empty = Ollama.
MODEL_API_KEY=

# --- Images -----------------------------------------------------------
# Local builds tag as :latest; CI pushes mujakkirpathan/devboard-*:sha-<short>.
IMAGE_TAG=latest
